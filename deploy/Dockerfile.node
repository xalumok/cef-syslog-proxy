# Proxy node: Vector plus the small Python agent that fetches config.
#
# Vector is pinned by version here and should be pinned by digest in a real registry.
# It sits in a security data path, so it is treated as a first-class dependency: it goes
# in the SBOM, and bumping it runs the full pipeline including the CEF conformance corpus.

ARG VECTOR_VERSION=0.51.0

FROM timberio/vector:${VECTOR_VERSION}-debian AS vector

FROM python:3.12-slim AS runtime

RUN groupadd --gid 10001 sixthsense \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sixthsense

COPY --from=vector /usr/bin/vector /usr/local/bin/vector

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir . && rm -rf /root/.cache

RUN mkdir -p /etc/vector /var/lib/vector \
 && chown -R sixthsense:sixthsense /etc/vector /var/lib/vector

COPY deploy/node-entrypoint.sh /usr/local/bin/node-entrypoint.sh
RUN chmod +x /usr/local/bin/node-entrypoint.sh

USER 10001:10001

# Binding 514 needs CAP_NET_BIND_SERVICE. The default is an unprivileged port so the
# container needs no capabilities at all unless you deliberately grant one.
ENV SS_CONTROL_PLANE_URL="http://control:8000" \
    SS_CONFIG_DIR="/etc/vector" \
    PYTHONUNBUFFERED=1

EXPOSE 5514/udp 9598
ENTRYPOINT ["/usr/local/bin/node-entrypoint.sh"]
